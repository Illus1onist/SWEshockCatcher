FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h 0.1
    volVectorFieldValue hU (0 0 0)
);

regions
(
    boxToCell
    {
        box             (-5 0 -0.05) (0 1 0.15);

        fieldValues
        (
            volScalarFieldValue h 1
            volVectorFieldValue hU (0 0 0)
        );
    }
);

