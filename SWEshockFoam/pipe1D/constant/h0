FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "constant";
    object      h0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left    { type zeroGradient; }
    right   { type zeroGradient; }
    bottom  { type empty; }
    top     { type empty; }
    frontAndBack { type empty; }
}

