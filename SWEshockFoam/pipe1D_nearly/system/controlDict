FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     SWEshockFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         16.5;
deltaT          0.0005;
writeControl    adjustableRunTime;
writeInterval   0.5;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  no;
radial          false;
