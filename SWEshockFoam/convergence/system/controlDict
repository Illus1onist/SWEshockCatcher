FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     SWEshockFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1.0;

deltaT          5e-05;
writeControl    adjustableRunTime;
writeInterval   1.0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  no;

cfl             0.1;
radial          false;
